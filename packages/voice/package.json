{
	"name": "@slipher/voice",
	"version": "0.1.0",
	"description": "Discord voice connections and DAVE for Seyfert",
	"private": false,
	"type": "commonjs",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tiramisulabs/extra.git",
		"directory": "packages/voice"
	},
	"homepage": "https://github.com/tiramisulabs/extra/tree/main/packages/voice",
	"bugs": {
		"url": "https://github.com/tiramisulabs/extra/issues"
	},
	"keywords": [
		"discord",
		"seyfert",
		"voice",
		"dave",
		"mls"
	],
	"engines": {
		"node": ">=22.13"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"lib/**"
	],
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"deno": "./lib/runtime/deno.js",
			"bun": "./lib/runtime/bun.js",
			"node": "./lib/index.js",
			"require": "./lib/index.js",
			"default": "./lib/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "tsc --watch",
		"build": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc",
		"lint": "biome lint --write ./src ./test",
		"format": "biome format --write ./src ./test",
		"checkb": "biome check --write --no-errors-on-unmatched ./src ./test",
		"typecheck": "tsc --noEmit --project ./test/tsconfig.json",
		"test": "pnpm typecheck && vitest run --config ./test/vitest.config.mts ./test/",
		"prepublishOnly": "pnpm build"
	},
	"devDependencies": {
		"@slipher/testing": "workspace:*",
		"@types/node": "^26.0.1",
		"seyfert": "^5.0.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"peerDependencies": {
		"seyfert": ">=5.0.0"
	},
	"dependencies": {
		"@noble/ciphers": "2.3.0",
		"@noble/curves": "2.3.0",
		"@noble/hashes": "2.3.0"
	}
}
