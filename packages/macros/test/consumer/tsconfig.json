{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "plugins": [
      {
        "name": "@slipher/macros/plugin"
      }
    ]
  },
  "include": [
    "src"
  ]
}
