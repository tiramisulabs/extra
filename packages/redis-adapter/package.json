{
	"name": "@slipher/redis-adapter",
	"version": "0.0.9",
	"private": false,
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"lib/**"
	],
	"main": "./lib/index.js",
	"module": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"scripts": {
		"bench:atomic": "pnpm build && node ./benchmarks/atomic-writes.mjs",
		"dev": "tsc --watch",
		"build": "tsc",
		"lint": "biome lint --write ./src ./test",
		"format": "biome format --write ./src ./test",
		"typecheck": "tsc --noEmit --project ./test/tsconfig.json",
		"test": "vitest run --config ./test/vitest.config.mts ./test/",
		"checkb": "biome check --write --no-errors-on-unmatched ./src ./test",
		"prepublish": "pnpm build"
	},
	"dependencies": {
		"@redis/client": "^6.0.1"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"seyfert": "https://pkg.pr.new/seyfert@f73b268f1d0acd3ea94ff5d9729d411e13c0b2a9",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"seyfert": ">=5.1.0"
	}
}
