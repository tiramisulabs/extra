{
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ESNext",
		"types": ["node"],
		"rootDir": ".",
		"outDir": "dist",
		"strict": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "lab/**/*.ts"]
}
